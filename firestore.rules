rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    // A workshop weapon may carry the author's custom weapon image (a bounded
    // dataURL) so recipients see it too. Keep it well under Firestore's 1MB doc
    // cap; null / absent is always fine. (.get avoids errors on missing keys.)
    function weaponImageWithinLimit(data) {
      return (!('weaponImage' in data)
          || data.weaponImage == null
          || data.weaponImage.get('src', '').size() < 900000)
          && (!('offhandImage' in data)
          || data.offhandImage == null
          || data.offhandImage.get('src', '').size() < 900000)
          && (!('hatImage' in data)
          || data.hatImage == null
          || data.hatImage.get('src', '').size() < 900000)
          && (!('hatImages' in data)
          || data.hatImages == null
          || data.hatImages.size() <= 5)
          && (!('effectImages' in data)
          || data.effectImages == null
          || data.effectImages.size() <= 24);
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /costumes/{costumeId} {
      allow read: if true;
      allow write: if false;
    }

    // 어드민 목록: Firebase 콘솔에서만 쓸 수 있고, 본인 문서만 읽기 허용.
    match /admin/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // 무기 정본 모션(Tier-1): 전체 read, 어드민만 write.
    match /weapon_motions/{weaponKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 공방 무기(Tier-2): 공개 브라우징을 위해 read는 허용하고, 클라이언트가
    // status=published/누락 문서만 표시한다. 작성자만 생성/수정,
    // 어드민은 모더레이션(status) 가능. 누구나 카운터(likes/plays/reports)만 증가 가능.
    match /workshop_weapons/{weaponId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.author_id)
                  && weaponImageWithinLimit(request.resource.data);
      allow update: if (isOwner(resource.data.author_id) && weaponImageWithinLimit(request.resource.data))
                  || isAdmin()
                  || (signedIn() && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['likes', 'plays', 'reports', 'updated_at']));
      allow delete: if isOwner(resource.data.author_id) || isAdmin();
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /user_items/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /user_costumes/{costumeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /match_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }
    }
  }
}
